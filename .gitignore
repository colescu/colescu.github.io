# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Local previews and downloaded map source files
local/

# Python caches and local environments used by map generation
__pycache__/
*.py[cod]
.venv/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file and bundle for alternative installation
vendor/
.bundle/

